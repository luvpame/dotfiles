{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "guard-and-guide",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "\"$HOME/.codex/hooks/herdr-usage.py\"",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "\"$HOME/.config/herdr/scripts/agent-git-metadata.py\"",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "printf '%s\\n' 'pstack:poteto-mode スキルを読み、このセッションに適用すること。モデルと推論強度は AGENTS.md の pstack 設定を優先する。'",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/nasuno.ayumu/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent codex 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.codex/hooks/herdr-usage.py\"",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "\"$HOME/.config/herdr/scripts/agent-git-metadata.py\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/herdr/scripts/agent-activity.py\"",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/herdr/scripts/agent-activity.py\"",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ]
  }
}
