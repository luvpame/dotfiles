{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "guard-and-guide",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "\"$HOME/.codex/hooks/herdr-usage.py\"",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "\"$HOME/.config/herdr/scripts/agent-git-metadata.py\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.codex/hooks/herdr-usage.py\"",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "\"$HOME/.config/herdr/scripts/agent-git-metadata.py\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/hooks/herdr-tab-rename-reminder.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
