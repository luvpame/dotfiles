{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "fish -c 'python3 \"$HOME/.codex/hooks/jev-monitor.py\"'",
            "timeout": 12,
            "additionalContextLimit": 600,
            "statusMessage": "Jev が作業の進め方を確認しています",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "guard-and-guide",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.codex/hooks/herdr-usage.py\"",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "\"$HOME/.config/herdr/scripts/agent-git-metadata.py\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.codex/hooks/herdr-usage.py\"",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "\"$HOME/.config/herdr/scripts/agent-git-metadata.py\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/hooks/herdr-tab-rename-reminder.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
