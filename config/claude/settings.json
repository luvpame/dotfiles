{
  "env": {
    "AGENT_BROWSER_CDP": "9222",
    "AGENT_BROWSER_PIN_TAB": "1",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.dotfiles/config/claude/mods/usage-band",
    "CLAUDE_CODE_PLUGIN_DIR_WATCH": "1"
  },
  "permissions": {
    "allow": [
      "Workflow"
    ],
    "defaultMode": "auto"
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "guard-and-guide",
            "statusMessage": "guard-and-guide 判定中"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/rtk-rewrite.sh",
            "statusMessage": "rtk 書き換え中"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-tab-rename-reminder.sh\"",
            "timeout": 5,
            "statusMessage": "herdr タブ名を確認中"
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/agent-memory-reminder.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10,
            "statusMessage": "herdr にセッションを通知中"
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/nasuno.ayumu/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.py"
  },
  "enabledPlugins": {
    "cclens@cclens": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "crit@crit": true,
    "frontend-design@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "ruby-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "mattpocock-skills@mattpocock": false,
    "i-have-adhd@i-have-adhd": true,
    "launchpad@sandbox-launchpad": true,
    "pstack@pstack-claude": true
  },
  "extraKnownMarketplaces": {
    "cclens": {
      "source": {
        "source": "github",
        "repo": "lambdalisue/cclens"
      }
    },
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "pstack-claude": {
      "source": {
        "source": "github",
        "repo": "michael-denyer/pstack-claude"
      }
    }
  },
  "viewMode": "focus",
  "language": "日本語",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-fable-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "editorMode": "vim",
  "verbose": false,
  "autoContinueAtUsageLimit": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(make rspec:*)",
      "Bash(make rubocop:*)",
      "Bash(pnpm test:once:*)",
      "Bash(pnpm lint:*)",
      "Bash(curl) POST to Slack incoming webhooks (https://hooks.slack.com/services/*) to notify the team channel from the review-migration-adr routine; payload is a short PR-review request message"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(make m:*) in backend/ when ALLOW_DESTRUCTIVE_SCHEMA_CHANGE is set (destructive Ridgepole schema change, per .claude/rules/db-schema.md)",
      "gh workflow run / deploy-prod* and ecs-exec-prod-backend-api* GitHub Actions workflows"
    ]
  },
  "voiceEnabled": false,
  "outputStyle": "Concise"
}
