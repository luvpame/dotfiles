{
  "env": {
    "AGENT_BROWSER_CDP": "9222",
    "AGENT_BROWSER_PIN_TAB": "1",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.dotfiles/config/claude/mods/markdown-colors:~/.dotfiles/config/claude/mods/turn-timeline:~/.dotfiles/config/claude/mods/ascii-sharks-light"
  },
  "permissions": {
    "allow": [
      "Workflow"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5-2",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "guard-and-guide",
            "statusMessage": "guard-and-guide 判定中"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/rtk-rewrite.sh",
            "statusMessage": "rtk 書き換え中"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/agent-memory-reminder.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/desktop-worktree-setup.sh\"",
            "timeout": 60,
            "statusMessage": "worktree をセットアップ中"
          }
        ]
      },
      {
        "matcher": "^(startup|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/poteto-mode.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.py"
  },
  "enabledPlugins": {
    "cclens@cclens": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "ruby-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "mattpocock-skills@mattpocock": true,
    "i-have-adhd@i-have-adhd": true,
    "launchpad@sandbox-launchpad": true,
    "cc-plugin-you-should-know@builtin": true,
    "pstack@cursor-plugins": true,
    "demo-video@demo-video": true,
    "hyperframes@hyperframes": true
  },
  "extraKnownMarketplaces": {
    "skills": {
      "source": {
        "source": "github",
        "repo": "mathbullet/skills"
      }
    },
    "cclens": {
      "source": {
        "source": "github",
        "repo": "lambdalisue/cclens"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      }
    },
    "demo-video": {
      "source": {
        "source": "github",
        "repo": "luvpame/demo-video"
      }
    },
    "hyperframes": {
      "source": {
        "source": "git",
        "url": "https://github.com/heygen-com/hyperframes.git"
      }
    }
  },
  "outputStyle": "Concise",
  "viewMode": "focus",
  "language": "日本語",
  "modelSettings": {
    "claude-fable-5-2": {
      "effortLevel": "low"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "light-daltonized",
  "editorMode": "vim",
  "verbose": false,
  "switchModelsOnFlag": true,
  "autoContinueAtUsageLimit": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true
}
