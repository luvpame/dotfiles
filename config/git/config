[alias]
  s   = switch
  st  = stash -u
  stp = stash pop
  sta = stash apply
  a   = add
  c   = commit
  p   = pull
  ps  = push
  d   = "!echo 'git clean -fd && git restore .' && git clean -fd && git restore ."
  f   = fetch
[color]
  ui = true
[pull]
  ff = only
[init]
  defaultBranch = main
[gpg]
  format = ssh
[gpg "ssh"]
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
  gpgsign = true
[push]
  autoSetupRemote = true
[core]
  editor = nvim
  pager  = hunk pager
[merge]
    conflictStyle = diff3
[merge "mergiraf"]
    name = mergiraf
    driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L
[include]
  path = ~/.config/git/config.local
